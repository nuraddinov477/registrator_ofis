// UniSchedule ma'lumotlar modeli
// SQLite (hozir) — PostgreSQL'ga o'tish uchun provider = "postgresql" qiling.
// Topshiriqdagi jadval-input strukturasini to'liq qamrab oladi:
//   groups(size, direction_id) · teachers · subjects · workloads · rooms(capacity, type) · room_permissions

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql" // POSTGRES-READY: "postgresql" ga o'zgartiring
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Tashkiliy tuzilma ───────────────────────────

model Faculty {
  id          Int          @id @default(autoincrement())
  name        String
  code        String?
  description String?
  departments Department[]
  specialties Specialty[]
  groups      Group[]
  users       User[]
  buildings   Building[] // ESKI (yagona egalik) — DEPRECATED, ownedBuildings'ga qarang
  ownedBuildings Building[] @relation("BuildingFaculties") // YANGI: ko'p-ko'pga egalik
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String
  code      String?
  head      String?
  faculty   Faculty?  @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  facultyId Int?
  teachers  Teacher[]
  users        User[]
  requestsFrom TeachingRequest[] @relation("RequestFrom")
  requestsTo   TeachingRequest[] @relation("RequestTo")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Yo'nalish / mutaxassislik = topshiriqdagi "direction_id"
model Specialty {
  id              Int              @id @default(autoincrement())
  name            String
  code            String?
  form            String? // Kunduzgi / Sirtqi / Kechki
  years           Int              @default(4)
  faculty         Faculty?         @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  facultyId       Int?
  groups          Group[]
  roomPermissions RoomPermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// ─────────────────────────── Resurslar ───────────────────────────

model Teacher {
  id              Int              @id @default(autoincrement())
  fullName        String
  position        String? // Assistent / Katta o'qituvchi / Dotsent / Professor
  degree          String? // PhD / DSc
  email           String?
  // Ish holati: "faol" | "dekret" | "ta'til". Faol bo'lmagan o'qituvchiga
  // almashtirish ustasi yuklamalarini hamkasblarga o'tkazadi.
  status          String           @default("faol")
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId    Int?
  workloads       Workload[]
  roomPermissions RoomPermission[]
  teachingRequests TeachingRequest[]
  users           User[]
  constraint      TeacherConstraint?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Subject {
  id         Int        @id @default(autoincrement())
  name       String
  code       String?
  type       String? // Majburiy / Tanlov
  credit     Int        @default(3)
  lecture    Int        @default(30)
  practice   Int        @default(30)
  semester   Int        @default(1)
  // Yumshoq cheklash uchun: qiyin fanlar (1..5) ertalabki juftliklarga joylanadi
  difficulty Int        @default(3)
  workloads  Workload[]
  teachingRequests TeachingRequest[]
  roomPermissions  RoomPermission[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Group {
  id              Int              @id @default(autoincrement())
  name            String
  course          Int              @default(1)
  size            Int              @default(25) // talabalar soni (topshiriq: size)
  form            String?
  faculty         Faculty?         @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  facultyId       Int?
  specialty       Specialty?       @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  specialtyId     Int? // direction_id
  workloadGroups  WorkloadGroup[]
  roomPermissions RoomPermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Building {
  id        Int      @id @default(autoincrement())
  name      String
  floors    Int      @default(1)
  address   String?
  // ESKI (yagona egalik) — DEPRECATED, endi ishlatilmaydi. Faqat productiondagi eski
  // ma'lumotni bir martalik backfill qilish uchun saqlanmoqda (server/src/index.js'ga
  // qarang) — hali OLIB TASHLANMAYDI, chunki `prisma db push` ustunni zudlik bilan
  // o'chirib yuborardi (backfill ulgurmasdan). Keyinroq, backfill tasdiqlangandan
  // so'ng, alohida deployda olib tashlanadi.
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  facultyId Int?
  // YANGI: bino BIR NECHTA fakultetga tegishli bo'lishi mumkin (ko'p-ko'pga) — bo'sh
  // massiv = "asosiy/umumiy bino", hamma fakultet foydalanadi. Bo'sh bo'lmasa — FAQAT
  // shu fakultet(lar) guruhlari jadvalga shu bino xonalaridan foydalana oladi (qattiq
  // cheklash, engine'da: loadData.js/schedule.js).
  faculties Faculty[] @relation("BuildingFaculties")
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id          Int              @id @default(autoincrement())
  name        String
  capacity    Int              @default(30)
  // Topshiriq 6: "umumiy" (hamma) | "maxsus" (faqat ruxsat bilan)
  type        String           @default("umumiy")
  kind        String? // Ma'ruza / Amaliy / Laboratoriya / Kompyuter
  // Jihoz/xususiyatlar — JSON-string massiv, masalan '["Proyektor","Konditsioner"]'
  features    String?
  building    Building?        @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  buildingId  Int?
  permissions RoomPermission[]
  teachingRequests TeachingRequest[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Maxsus xona ruxsatnomasi (topshiriq 7): o'qituvchi / guruh / yo'nalishga beriladi
model RoomPermission {
  id          Int        @id @default(autoincrement())
  room        Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId      Int
  teacher     Teacher?   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   Int?
  group       Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     Int?
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  specialtyId Int?
  // Fan bo'yicha ruxsat (masalan "Jismoniy tarbiya" → sport zali): shu FANNING darslari
  // (qaysi guruh/o'qituvchi bo'lishidan qat'i nazar) bu xonaga kira oladi. Fakultetlar
  // aro umumiy fanlar (jismoniy tarbiya kabi) uchun ayniqsa foydali — guruh/o'qituvchi/
  // yo'nalish sanab chiqishga hojat qoldirmaydi.
  subject     Subject?   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId   Int?
  // exclusive=true (faqat guruh ruxsatida ma'noli): bu guruh FAQAT shu xona(lar)da dars
  // o'tadi — jadval tuzishda boshqa xona nomzod bo'lmaydi (qat'iy). exclusive=false —
  // shunchaki ruxsat + yumshoq ustuvorlik (assignedRoom).
  exclusive   Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

// O'qituvchi istisnosi (jadval generatsiyasida qat'iy hisobga olinadi — loadData.js):
// qaysi kunlarda dars qo'yilmasin (blockedDays) va/yoki FAQAT qaysi paralarga qo'yilsin
// (allowedPairs). Ikkisi ham bo'sh bo'lsa — cheklovsiz. Har o'qituvchida bittadan (unique).
model TeacherConstraint {
  id           Int      @id @default(autoincrement())
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId    Int      @unique
  blockedDays  String? // JSON massiv, kun indekslari 0..4 (Dushanba..Juma), masalan "[0,4]"
  allowedPairs String? // JSON massiv, para raqamlari 1..6, masalan "[3,4,5]" — bo'sh = cheklovsiz
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Sayt darajasidagi sozlama — yagona qator (id=1). Texnik xizmat rejimi: yoqilsa,
// Super Admin'dan boshqa hech kim saytdan (API'dan) foydalana olmaydi — bu OSHKORA
// funksiya, istalgan Super Admin hisobi boshqara oladi va Audit jurnaliga yoziladi
// (yashirin/maxfiy emas — server/src/routes/siteSettings.js).
model SiteSetting {
  id                 Int      @id @default(1)
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  updatedAt          DateTime @updatedAt
}

// ─────────────────────────── Ish yuklamasi (engine kirishi) ───────────────────────────

model Workload {
  id          Int              @id @default(autoincrement())
  groups      WorkloadGroup[]
  teacher     Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   Int
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId   Int
  // haftalik_soatlar = haftadagi juftliklar soni (engine shuncha "event" yaratadi) — guruhlar
  // soniga qaramasdan BIR MARTA sanaladi (potok — bir dars, bir nechta guruh birga tinglaydi)
  weeklyHours Int              @default(2)
  // Dars turi: Maʼruza / Seminar / Amaliy — bitta fan bir nechta turdagi yuklamaga bo'linishi
  // mumkin (masalan alohida ma'ruza va alohida seminar yuklamasi). Jadval tuzishda shu tur
  // bo'yicha tartib saqlanadi: ma'ruza birinchi, keyin seminar, keyin amaliy (constraints.js)
  type        String           @default("Amaliy")
  semester    Int              @default(1)
  // Yuklama HECH QACHON butunlay o'chmaydi — "o'chirish" faqat arxivga ko'chiradi
  // (guruh bog'lanishlari saqlanadi, kerak bo'lsa tiklanadi). Arxivlangan yuklama
  // jadval generatsiyasida va almashtirish ustasida hisobga olinmaydi.
  archived    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Yuklama ↔ guruh (ko'p-ko'pga) — potok: bitta dars bir nechta guruhga birga o'tiladi
model WorkloadGroup {
  workload   Workload @relation(fields: [workloadId], references: [id], onDelete: Cascade)
  workloadId Int
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    Int

  @@id([workloadId, groupId])
}

// ─────────────────────────── Jadval chiqishi (engine natijasi) ───────────────────────────

model SchedulingRun {
  id        Int             @id @default(autoincrement())
  semester  Int             @default(1)
  status    String          @default("draft") // draft / running / done / failed
  hardScore Int             @default(0) // qattiq cheklash buzilishlari
  softScore Int             @default(0) // yumshoq cheklash jarimasi
  // Tashxis (JSON-string): guruh/o'qituvchi yuklama oshib ketishi, xonasiz/vaqtsiz
  // qolgan darslar va sabablari — nima uchun "failed" bo'lganini aniq ko'rsatadi
  report    String?
  // Jadval HECH QACHON butunlay o'chmaydi — "o'chirish" faqat arxivga ko'chiradi
  // (barcha darslari saqlanadi, kerak bo'lsa tiklanadi). Tarix to'liq saqlanadi.
  archived  Boolean         @default(false)
  entries   ScheduleEntry[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// Chiqish formati: { group_id, teacher_id, subject_id, room_id, day, pair }
model ScheduleEntry {
  id        Int           @id @default(autoincrement())
  run       SchedulingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     Int
  groupId   Int
  teacherId Int
  subjectId Int
  roomId    Int
  day       Int // 0..4 (Dushanba..Juma)
  pair      Int // 1..6
  type      String @default("Amaliy") // Maʼruza / Seminar / Amaliy — Workload.type'dan ko'chiriladi

  @@index([runId])
}

// ─────────────────────────── Tizim ───────────────────────────

model User {
  id           Int         @id @default(autoincrement())
  login        String      @unique
  fullName     String
  email        String?
  role         String      @default("Fakultet operatori")
  active       Boolean     @default(true)
  passwordHash String?
  // Rol qamrovi (scoping): userni o'z birligiga bog'laydi.
  //   Fakultet operatori → facultyId, Kafedra mudiri → departmentId, Oʻqituvchi → teacherId
  faculty      Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  facultyId    Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  departmentId Int?
  teacher      Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId    Int?
  // Super Admin qo'yadigan shaxsiy cheklovlar (JSON-string):
  //   { readOnly?: bool, denyWrite?: [resource...], denyRead?: [section...] }
  restrictions String?
  // Eng yuqori (egalik) darajasi — login/parolga BOG'LIQ EMAS, shu sabab hisob egasi
  // o'z login/parolini erkin o'zgartirsa ham bu huquq saqlanadi. Umumiy CRUD (PUT
  // /users) orqali o'zgartirilmaydi (schemas.js'da yo'q) — faqat to'g'ridan-to'g'ri
  // DB orqali beriladi. Egasidan boshqa hech kim (boshqa Super Admin'lar ham) buni
  // o'zi yoki boshqalarga bera olmaydi.
  isOwner      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model AuditLog {
  id     Int      @id @default(autoincrement())
  time   DateTime @default(now())
  user   String   @default("admin")
  action String
  detail String
  ip     String   @default("127.0.0.1")
}

// ─────────────────────────── Kafedralararo ariza ───────────────────────────
// Bir kafedra boshqasidan o'qituvchi/dars so'raydi (masalan: "ingliz tili
// o'qituvchingiz shu xonada shu guruhlarga dars bersin"). Ikkinchi taraf qabul
// yoki rad qiladi. Butun tarix sana bilan saqlanadi — Super Admin ko'radi.
model TeachingRequest {
  id               Int         @id @default(autoincrement())
  fromDepartment   Department? @relation("RequestFrom", fields: [fromDepartmentId], references: [id], onDelete: SetNull)
  fromDepartmentId Int?
  toDepartment     Department? @relation("RequestTo", fields: [toDepartmentId], references: [id], onDelete: SetNull)
  toDepartmentId   Int?
  teacher          Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId        Int?
  subject          Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId        Int?
  room             Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomId           Int?
  course           Int? // qaysi kurs (1..4)
  targetGroups     String? // qaysi guruhlar — erkin matn: "IT-21, IT-22"
  weeklyHours      Int? // haftalik soat (juftlik)
  message          String? // so'rov izohi
  status           String      @default("pending") // pending | accepted | rejected
  responseNote     String? // javob izohi
  respondedBy      String? // kim javob berdi (login)
  respondedAt      DateTime?
  createdBy        String? // kim yaratdi (login)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
}
